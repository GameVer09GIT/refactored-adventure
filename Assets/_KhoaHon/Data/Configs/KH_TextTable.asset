    text: "B\u1EADt"
  - key: ui.off
    text: "T\u1EAFt"
  - key: ui.key.move
    text: "Di chuy\u1EC3n"
  - key: ui.key.run
    text: "Ch\u1EA1y"
  - key: ui.key.interact
    text: "T\u01B0\u01A1ng t\xE1c"
  - key: ui.key.notebook
    text: "S\u1ED5 tay"
  - key: ui.key.hotbar
    text: "\u0110\u1ED5i v\u1EADt ph\u1EA9m"

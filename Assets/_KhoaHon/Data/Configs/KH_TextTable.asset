%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: db3913ed5f51e5045acd20091cb8bb5d, type: 3}
  m_Name: KH_TextTable
  m_EditorClassIdentifier: Assembly-CSharp::KhoaHon.Core.TextTable
  entries:
  - key: prompt.open_door
    text: "[E] M\u1EDF c\u1EEDa"
  - key: prompt.close_door
    text: "[E] \u0110\xF3ng c\u1EEDa"
  - key: prompt.locked
    text: "C\u1EEDa b\u1ECB kh\xF3a"
  - key: prompt.unlock_with
    text: "[E] M\u1EDF kh\xF3a b\u1EB1ng {0}"
  - key: prompt.pickup
    text: "[E] Nh\u1EB7t {0}"
  - key: prompt.read
    text: "[E] \u0110\u1ECDc: {0}"
  - key: prompt.inspect
    text: '[E] Xem'
  - key: prompt.main_door_locked
    text: "C\u1EEDa ch\xEDnh \u0111\xE3 b\u1ECB then c\xE0i, kh\xF4ng m\u1EDF \u0111\u01B0\u1EE3c"
  - key: prompt.stair_door_locked
    text: "C\u1EEDa l\xEAn t\u1EA7ng hai b\u1ECB kh\xF3a"
  - key: prompt.chains
    text: "N\u1EAFp h\u1EA7m b\u1ECB kh\xF3a b\u1EB1ng 5 s\u1EE3i x\xEDch"
  - key: prompt.altar
    text: "B\xE0n th\u1EDD gia t\u1ED9c \u2014 13 b\xE0i v\u1ECB, 5 \u0111\xE0i sen"
  - key: prompt.body
    text: '[E] Xem'
  - key: msg.chains
    text: "N\u0103m s\u1EE3i x\xEDch l\u1EDBn n\u1ED1i ng\u1EA7m v\xE0o t\u01B0\u1EDDng.
      Kh\xF4ng c\xF3 \u1ED5 kh\xF3a n\xE0o c\u1EA3."
  - key: msg.altar
    text: "N\u0103m \u0111\xE0i sen tr\u1ED1ng, m\u1ED7i \u0111\xE0i n\u1EB1m d\u01B0\u1EDBi
      m\u1ED9t b\xE0i v\u1ECB kh\u1EAFc t\xEAn m\u1ED9t h\xE0nh."
  - key: msg.rubble
    text: "\u0110\xE1 s\u1EADp k\xEDn m\u1ED9t \u0111\u01B0\u1EDDng h\u1EA7m khoan
      h\u1EB9p. Kh\xF4ng \u0111i ti\u1EBFp \u0111\u01B0\u1EE3c."
  - key: key.upstairs
    text: "ch\xECa kh\xF3a c\u1EEDa c\u1EA7u thang"
  - key: item.backpack
    text: "balo c\u1EE7a Qu\xE2n"
  - key: item.battery
    text: "pin ti\u1EC3u"
  - key: item.film
    text: "cu\u1ED9n phim"
  - key: item.safe_placeholder
    text: "\u0111\u1ED3 trong k\xE9t s\u1EAFt (t\u1EA1m)"
  - key: item.tape
    text: "cu\u1ED9n b\u0103ng cassette"
  - key: item.newspaper
    text: "m\u1EA9u b\xE1o c\u0169"
  - key: item.relic_moc
    text: "b\xFAp b\xEA v\u1EA3i"
  - key: item.relic_thuy
    text: "huy\u1EBFt th\u01B0"
  - key: item.relic_tho
    text: "l\u01B0\u1EE3c s\u1EEBng g\xE3y"
  - key: item.relic_kim
    text: "b\xFAa \u0111\xF3ng \u0111inh"
  - key: item.relic_hoa
    text: "\u0111\xF4i h\xE0i th\xEAu"
  - key: item.generic
    text: "v\u1EADt ph\u1EA9m"
  - key: toast.got_item
    text: "\u0110\xE3 nh\u1EB7t: {0}"
  - key: toast.notebook_added
    text: "\u0110\xE3 ghi v\xE0o S\u1ED5 tay: {0}"
  - key: toast.saved
    text: "\u0110\xE3 l\u01B0u ti\u1EBFn tr\xECnh"
  - key: toast.no_save
    text: "Ch\u01B0a c\xF3 b\u1EA3n l\u01B0u"
  - key: hint.backpack
    text: "C\xF3 th\u1EC3 nghe cu\u1ED9n b\u0103ng b\u1EB1ng m\xE1y ghi \xE2m (Tab
      > B\u0103ng ghi \xE2m)"
  - key: sub.front_door_slam
    text: "(C\u1EEDa ch\xEDnh s\u1EADp l\u1EA1i sau l\u01B0ng. Then c\xE0i r\u01A1i
      xu\u1ED1ng.)"
  - key: ui.close
    text: "\u0110\xF3ng [E]"
  - key: notebook.title
    text: "S\u1ED5 tay \u0111i\u1EC1u tra"
  - key: notebook.hint
    text: "Tab / J: \u0111\xF3ng  \xB7  Q / E: \u0111\u1ED5i tab"
  - key: notebook.tab.documents
    text: "T\xE0i li\u1EC7u"
  - key: notebook.tab.tapes
    text: "B\u0103ng ghi \xE2m"
  - key: notebook.tab.photos
    text: "\u1EA2nh"
  - key: notebook.tab.talismans
    text: "B\xF9a ch\xFA"
  - key: notebook.tab.relics
    text: "K\u1EF7 v\u1EADt"
  - key: notebook.empty
    text: "Ch\u01B0a c\xF3 g\xEC."
  - key: notebook.new
    text: "m\u1EDBi"
  - key: notebook.tape_hint
    text: "C\u1EA7m m\xE1y ghi \xE2m \u0111\u1EC3 nghe cu\u1ED9n b\u0103ng n\xE0y."
  - key: intro.1
    text: "Qu\xE2n m\u1EA5t t\xEDch \u1EDF bi\u1EC7t th\u1EF1 Thanh V\xE2n \u0111\xE3
      m\u01B0\u1EDDi b\u1ED1n ng\xE0y."
  - key: intro.2
    text: "\u0110\xEAm cu\u1ED1i c\xF9ng, n\xF3 g\u1EEDi cho t\xF4i m\u1ED9t t\u1EA5m
      \u1EA3nh ch\u1EE5p s\xE0n nh\xE0 b\u1EBFp. C\u1EA3nh s\xE1t n\xF3i \u0111\xF3
      ch\u1EC9 l\xE0 v\u1EBFt b\u1EA9n."
  - key: intro.3
    text: "T\xF4i kh\xF4ng tin."
  - key: prompt.door_stuck
    text: "C\u1EEDa k\u1EB9t c\u1EE9ng, kh\xF4ng m\u1EDF \u0111\u01B0\u1EE3c"
  - key: prompt.locked_outside
    text: "C\u1EEDa b\u1ECB kh\xF3a t\u1EEB b\xEAn ngo\xE0i"
  - key: prompt.hide_wardrobe
    text: "[E] Tr\u1ED1n v\xE0o t\u1EE7"
  - key: prompt.hide_bed
    text: "[E] Chui xu\u1ED1ng g\u1EA7m gi\u01B0\u1EDDng"
  - key: prompt.hide_exit
    text: "[E] Ra ngo\xE0i"
  - key: prompt.hold_breath
    text: "Gi\u1EEF [Space] \u0111\u1EC3 n\xEDn th\u1EDF!"
  - key: sub.hk_run
    text: "Ch\u1EA1y \u0111i\u2026"
  - key: sub.hk_comb
    text: "Ch\u1EA1y \u0111i\u2026 ta kh\xF4ng ki\u1EC1m ch\u1EBF \u0111\u01B0\u1EE3c\u2026"
  - key: sub.hk_lullaby
    text: "\u266A \u1EA6u \u01A1\u2026 ng\u1EE7 \u0111i con, \u0111\xEAm d\xE0i\u2026
      c\u1EEDa \u0111\xE3 kh\xF3a\u2026 \u0111\xE8n \u0111\xE3 t\xE0n\u2026 \u266A"
  - key: ui.title_top
    text: "L\u1EDCI NGUY\u1EC0N"
  - key: ui.title_main
    text: "KH\xD3A H\u1ED2N"
  - key: ui.continue
    text: "Ti\u1EBFp t\u1EE5c"
  - key: ui.new_game
    text: "Tr\xF2 ch\u01A1i m\u1EDBi"
  - key: ui.settings
    text: "C\xE0i \u0111\u1EB7t"
  - key: ui.credits
    text: "Th\xF4ng tin"
  - key: ui.quit
    text: "Tho\xE1t"
  - key: ui.version
    text: "Bi\u1EC7t th\u1EF1 Thanh V\xE2n \xB7 b\u1EA3n th\u1EED nghi\u1EC7m 0.3"
  - key: ui.menu_hint
    text: "N\xEAn \u0111eo tai nghe v\xE0 ch\u01A1i trong b\xF3ng t\u1ED1i."
  - key: ui.confirm_new
    text: "B\u1EAFt \u0111\u1EA7u l\u1EA1i t\u1EEB \u0111\u1EA7u? Ti\u1EBFn tr\xECnh
      \u0111\xE3 l\u01B0u s\u1EBD b\u1ECB x\xF3a."
  - key: ui.confirm_quit
    text: "Tho\xE1t game?"
  - key: ui.confirm_menu
    text: "V\u1EC1 menu ch\xEDnh? Ti\u1EBFn tr\xECnh t\u1EEB \u0111i\u1EC3m l\u01B0u
      g\u1EA7n nh\u1EA5t s\u1EBD m\u1EA5t."
  - key: ui.confirm_reload
    text: "T\u1EA3i l\u1EA1i \u0111i\u1EC3m l\u01B0u g\u1EA7n nh\u1EA5t?"
  - key: ui.yes
    text: "\u0110\u1ED3ng \xFD"
  - key: ui.no
    text: "H\u1EE7y"
  - key: ui.confirm
    text: "X\xE1c nh\u1EADn"
  - key: ui.back
    text: "Quay l\u1EA1i"
  - key: ui.apply
    text: "\xC1p d\u1EE5ng"
  - key: ui.defaults
    text: "M\u1EB7c \u0111\u1ECBnh"
  - key: ui.applied
    text: "\u0110\xE3 \xE1p d\u1EE5ng c\xE0i \u0111\u1EB7t"
  - key: ui.paused
    text: "T\u1EA0M D\u1EEANG"
  - key: ui.resume
    text: "Ti\u1EBFp t\u1EE5c"
  - key: ui.reload_checkpoint
    text: "T\u1EA3i l\u1EA1i \u0111i\u1EC3m l\u01B0u"
  - key: ui.main_menu
    text: "V\u1EC1 menu ch\xEDnh"
  - key: ui.pause_tip
    text: "B\xE0 ta kh\xF4ng ng\u1EE7. B\xE0 ta ch\u1EC9 ch\u1EDD."
  - key: ui.warning_title
    text: "C\u1EA2NH B\xC1O"
  - key: ui.warning_body
    text: "Tr\xF2 ch\u01A1i ch\u1EE9a h\xECnh \u1EA3nh m\xE1u me, x\xE1c ch\u1EBFt,
      \xE2m thanh \u0111\u1ED9t ng\u1ED9t v\xE0 \xE1nh s\xE1ng nh\u1EA5p nh\xE1y.\nKh\xF4ng
      ph\xF9 h\u1EE3p v\u1EDBi ng\u01B0\u1EDDi d\u01B0\u1EDBi 18 tu\u1ED5i, ng\u01B0\u1EDDi
      c\xF3 b\u1EC7nh tim ho\u1EB7c d\u1EC5 b\u1ECB k\xEDch \u0111\u1ED9ng.\n\nNh\u1EA5n
      ph\xEDm b\u1EA5t k\u1EF3 \u0111\u1EC3 ti\u1EBFp t\u1EE5c."
  - key: ui.calib_title
    text: "\u0110I\u1EC0U CH\u1EC8NH \u0110\u1ED8 S\xC1NG"
  - key: ui.calib_body
    text: "K\xE9o thanh tr\u01B0\u1EE3t cho t\u1EDBi khi h\xECnh b\xEAn tr\xE1i th\u1EA5y
      r\xF5, h\xECnh gi\u1EEFa th\u1EA5y m\u1EDD\nv\xE0 h\xECnh b\xEAn ph\u1EA3i
      G\u1EA6N NH\u01AF kh\xF4ng nh\xECn th\u1EA5y."
  - key: ui.credits_body
    text: "L\u1EDCI NGUY\u1EC0N KH\xD3A H\u1ED2N\n\nK\u1ECBch b\u1EA3n & thi\u1EBFt
      k\u1EBF: nh\xF3m d\u1EF1 \xE1n refactored-adventure\nL\u1EADp tr\xECnh, d\u1EF1ng
      c\u1EA3nh, \xE2m thanh t\u1ED5ng h\u1EE3p: Claude (Anthropic) c\xF9ng nh\xF3m\nT\xE0i
      nguy\xEAn: Flooded Grounds, Abandoned Asylum, Vintage Living Room, civilian_girl,
      Mixamo\nPh\xF4ng ch\u1EEF: Be Vietnam Pro, Noto Serif (SIL OFL)\n\nC\u1EA3m
      \u01A1n b\u1EA1n \u0111\xE3 d\xE1m b\u01B0\u1EDBc v\xE0o bi\u1EC7t th\u1EF1
      Thanh V\xE2n."
  - key: ui.tab.graphics
    text: "H\xECnh \u1EA3nh"
  - key: ui.tab.audio
    text: "\xC2m thanh"
  - key: ui.tab.controls
    text: "\u0110i\u1EC1u khi\u1EC3n"
  - key: ui.tab.display
    text: "Hi\u1EC3n th\u1ECB"
  - key: ui.h.screen
    text: "M\xE0n h\xECnh"
  - key: ui.h.quality
    text: "Ch\u1EA5t l\u01B0\u1EE3ng"
  - key: ui.h.volume
    text: "\xC2m l\u01B0\u1EE3ng"
  - key: ui.h.subtitles
    text: "Ph\u1EE5 \u0111\u1EC1"
  - key: ui.h.mouse
    text: "Chu\u1ED9t"
  - key: ui.h.keys
    text: "Ph\xEDm \u0111i\u1EC1u khi\u1EC3n"
  - key: ui.h.brightness
    text: "\u0110\u1ED9 s\xE1ng"
  - key: ui.h.hud
    text: "Giao di\u1EC7n"
  - key: ui.screen_mode
    text: "Ch\u1EBF \u0111\u1ED9 hi\u1EC3n th\u1ECB"
  - key: ui.fullscreen
    text: "To\xE0n m\xE0n h\xECnh"
  - key: ui.borderless
    text: "C\u1EEDa s\u1ED5 kh\xF4ng vi\u1EC1n"
  - key: ui.windowed
    text: "C\u1EEDa s\u1ED5"
  - key: ui.resolution
    text: "\u0110\u1ED9 ph\xE2n gi\u1EA3i"
  - key: ui.vsync
    text: "\u0110\u1ED3ng b\u1ED9 d\u1ECDc (VSync)"
  - key: ui.fps_cap
    text: "Gi\u1EDBi h\u1EA1n FPS"
  - key: ui.unlimited
    text: "Kh\xF4ng gi\u1EDBi h\u1EA1n"
  - key: ui.quality
    text: "Ch\u1EA5t l\u01B0\u1EE3ng \u0111\u1ED3 h\u1ECDa"
  - key: ui.fov
    text: "Tr\u01B0\u1EDDng nh\xECn (FOV)"
  - key: ui.motion_blur
    text: "L\xE0m m\u1EDD chuy\u1EC3n \u0111\u1ED9ng"
  - key: ui.film_grain
    text: "Nhi\u1EC5u h\u1EA1t phim"
  - key: ui.vol_master
    text: "T\u1ED5ng"
  - key: ui.vol_music
    text: "Nh\u1EA1c"
  - key: ui.vol_sfx
    text: "Hi\u1EC7u \u1EE9ng"
  - key: ui.vol_amb
    text: "M\xF4i tr\u01B0\u1EDDng"
  - key: ui.vol_voice
    text: "Gi\u1ECDng n\xF3i"
  - key: ui.subtitles
    text: "Hi\u1EC7n ph\u1EE5 \u0111\u1EC1"
  - key: ui.headphones
    text: "\xC2m thanh 3D \u0111\u01B0\u1EE3c thi\u1EBFt k\u1EBF cho tai nghe: ti\u1EBFng
      ch\xECa kh\xF3a cho bi\u1EBFt b\xE0 ta \u1EDF b\xEAn n\xE0o."
  - key: ui.sensitivity
    text: "\u0110\u1ED9 nh\u1EA1y chu\u1ED9t"
  - key: ui.brightness
    text: "\u0110\u1ED9 s\xE1ng"
  - key: ui.show_fps
    text: "Hi\u1EC7n FPS"
  - key: ui.language
    text: "Ng\xF4n ng\u1EEF"
